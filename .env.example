# Copy to .env and fill in to enable the backend.
# Without these, the app runs in fully-local mode (device-only accounts + progress).

# Supabase (accounts + cloud-synced progress). From your Supabase project:
#   Project Settings → API → Project URL and anon/public key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: a custom content API (overrides local placeholder content).
EXPO_PUBLIC_API_URL=
