{
  "name": "chessmaster",
  "version": "0.1.0",
  "private": true,
  "description": "ChessMaster — learn chess, prepare like a champion, and play the world. A B2C mobile app.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "verify:puzzles": "node scripts/verify-puzzles.js",
    "test:chess": "tsc src/engine/ai.ts src/engine/analyze.ts src/game/chessHelpers.ts --module commonjs --target es2019 --moduleResolution node --esModuleInterop --skipLibCheck --outDir .tsc-test && node scripts/test-chess.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.112.4",
    "chess.js": "^1.0.0-beta.8",
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^7.1.2",
    "typescript": "~5.3.3"
  }
}
